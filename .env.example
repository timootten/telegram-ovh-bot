# Telegram Bot Token (obtain via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL Connection String (matches compose.yaml)
DATABASE_URL=postgresql://dev:dev@localhost:5432/ovh_notifier

# OVH Subsidiary (default DE for EUR pricing with German VAT)
OVH_SUBSIDIARY=DE

# Whitelist allowed Telegram Chat IDs (comma-separated, optional)
# Only users with these chat IDs can interact with the bot
ALLOWED_CHAT_IDS=
